# Contains your real Firebase project values — copy from
# firebase-config.example.js and keep the real one out of git so it's easy
# to tell "example" from "real" at a glance. (It's not a secret — see the
# comment at the top of firebase-config.example.js — this is just tidiness.)
public/firebase-config.js

.DS_Store
node_modules/
.firebase/

# Automation bot's Firebase Auth credentials — local-only, never committed.
# The scheduled cloud routine gets these as private environment variables
# instead (set via the RemoteTrigger/routine config, not this repo).
.env.local
